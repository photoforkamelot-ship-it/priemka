# Скопируйте в backend/.env и заполните на сервере. Этот файл в git не попадает.
BOT_TOKEN=            # от @BotFather
DISK_TOKEN=           # OAuth-токен Яндекс Диска (docs/DEPLOY.md, шаг 3)
APP_URL=https://priemka.example.ru
WEBHOOK_SECRET=       # любая длинная строка: python3 -c "import secrets;print(secrets.token_hex(24))"
TZ_HOURS=7            # часовой пояс напоминаний (Томск = 7)
REMIND_HOUR=9
PORT=8080
